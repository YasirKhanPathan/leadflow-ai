generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  EMAIL
  COLD_OUTREACH
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum FollowUpStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum UserRole {
  OWNER
  MEMBER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  leads     Lead[]
  followUps FollowUp[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String
  role           UserRole     @default(OWNER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  followUps      FollowUp[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name          String
  email         String
  company       String?
  serviceNeeded String?
  budget        Decimal?   @db.Decimal(12, 2)
  currency      String     @default("USD") @db.Char(3)
  source        LeadSource @default(OTHER)
  status        LeadStatus @default(NEW)
  priority      Priority   @default(MEDIUM)
  notes         String?
  inquiry       String?

  aiSummary         String?
  aiService         String?
  aiBudget          String?
  aiTimeline        String?
  aiPriority        Priority?
  aiPriorityReason  String?
  aiDraftReply      String?
  aiReplyApprovedAt DateTime?
  aiAnalyzedAt      DateTime?

  wonAt     DateTime?
  lostAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  followUps FollowUp[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, priority])
}

model FollowUp {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User           @relation(fields: [createdById], references: [id])

  title       String?
  message     String?
  dueDate     DateTime
  status      FollowUpStatus @default(OPEN)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([organizationId, status, dueDate])
  @@index([leadId])
}
